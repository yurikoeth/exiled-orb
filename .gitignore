# Tauri
apps/overlay/src-tauri/target/
# Regenerated by tauri-build from capabilities/ on every build — tracking them
# just means committing churn, and a stale copy misreports the app's real
# permissions (this is what the upstream Tauri v2 template ignores too).
apps/overlay/src-tauri/gen/schemas/

# Machine-local cargo config (optional target-dir override)
apps/overlay/src-tauri/.cargo/

